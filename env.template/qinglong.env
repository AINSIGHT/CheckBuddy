## ==========================================================================
## 青龙面板 · 环境变量清单
##
## 用法：在面板「环境变量」里逐条添加（名称 = 值），
##       或在「配置文件」中导入本文件（纯 NAME= 格式，不带 export）。
## 只需要填用到的项，其余留空或不要添加。
## ⚠️ 定时任务命令必须是 task checkin.js，裸 node 不会注入面板环境变量。
## ==========================================================================

## ① 账号凭证（至少一个）
TRAE_CREDENTIALS=
WORKBUDDY_CREDENTIALS=
WORKBUDDY_REFRESH_TOKEN=
QODER_CREDENTIALS=
## Qoder 轮次约 10:00 刷新；未下发时等待重试分钟数（0=不等待，最多 30）
QODER_WAIT=0

## TRAE 客户端谱系（可选，留空自动 IDE→SOLO 回退；req_source 错配会 9074）
TRAE_CLIENT_ID=
TRAE_REQ_SOURCE=
## TRAE 设备证明（可选；新版续期 20405 需要。本地凭证 JSON 已含密钥无需填，
## 青龙/Actions 需从 extract 输出复制，PEM 换行写成 \n）
TRAE_DEVICE_KEY_PEM=
TRAE_DEVICE_PUB_PEM=
TRAE_DEVICE_ID=
TRAE_MACHINE_ID=
## Qoder 设备头（可选，2026-09-26 起官方要求；缺失更易「活动未下发」；
## 本机取值：node tools/qoder-umid.cjs）
QODER_CLIENT_TYPE=
QODER_MACHINE_TOKEN=
QODER_MACHINE_CODE=
QODER_MACHINE_TYPE=
QODER_MACHINE_ID=
QODER_MACHINE_OS=
QODER_MACHINE_HOSTNAME=
QODER_EXTRA_HEADERS=
## Qoder 地区（可选，留空默认 cn；token 失效时自动续期并探测国际版）
QODER_REGION=

## ② WorkBuddy 进阶（可选）
WB_BASE_URL=
WB_X_DOMAIN=
STATE_DIR=/ql/data
WB_GAP=3
WB_MAKEUP_MAX_PER_RUN=1
WB_TASKS=
WB_SKIP_TASKS=
WB_GROWTH_DISCOVER=0
WB_GROWTH_WRITE=0
WB_ACTIVITY_CONFIRM=0

## ③ 互动玩法（默认 0，置 1 开启抽奖/盲盒/Buddy/猫猫旅行）
WB_GAMES=0
WB_GAMES_TASKS=
WB_GAMES_SKIP=
WB_GAMES_BASE_URL=
WB_GAMES_MAX_DRAWS=20
WB_GAMES_MAX_BLINDBOX=5

## ③-b 本地凭证文件加载（青龙一般无需，脚本目录下无这些文件；置 0 可关闭）
LOCAL_CREDS=1

## ④ 通知（可选，配哪个推哪个；不填则只用青龙面板自带通知）
NOTIFY=always
BARK_URL=
PUSHPLUS_TOKEN=
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=
SERVERCHAN_SENDKEY=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
QL_URL=http://127.0.0.1:5700

## ==========================================================================
## 配套定时任务（面板本地时间）
##   日常全流程            5 10 * * *          task checkin.js
##   补签队列（可选）      10-50/10 9-11 * * *  task checkin.js --sign-retry-only
##   夜猫窗口（开启成长任务后） 37 23 * * *    task checkin.js --only workbuddy
## ==========================================================================
