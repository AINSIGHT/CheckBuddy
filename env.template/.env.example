## ==========================================================================
## 本地运行 · 全量环境变量模板（可 source）
##
## ⚠️ 脚本只读取 process.env，不会自动加载 .env 文件。
##    用法：cp .env.example .env → 编辑 .env → source .env → npm run checkin
##    青龙 / Actions / QD 请分别参考同目录下的 qinglong.env / actions-secrets.md / qd-variables.md
##
## 所有变量均为可选：配了哪个平台就跑哪个平台。
## 另支持本地凭证文件自动加载（见下方 LOCAL_CREDS）。
## 值一律用单引号包裹，含换行的多账号值请用 \n 或直接写多行字符串。
## ==========================================================================

## ---------------------------- ① 账号凭证 ----------------------------

## TRAE 桌面端凭证 JSON 数组
## 获取：node tools/extract-all-credentials.cjs --trae
## ⚠️ 每个账号必须带自己的真实 deviceId（12~20 位十进制数字）；一个真设备号一天只能签一个账号
export TRAE_CREDENTIALS=''

## 可选：强制指定客户端谱系（默认自动 IDE → SOLO 回退，一般不用填）
## req_source 必须与 token 谱系匹配，错配会 9074
## IDE : TRAE_CLIENT_ID=ono9krqynydwx5  TRAE_REQ_SOURCE=1
## SOLO: TRAE_CLIENT_ID=en1oxy7wnw8j9n  TRAE_REQ_SOURCE=2
export TRAE_CLIENT_ID=''
export TRAE_REQ_SOURCE=''

## WorkBuddy 凭证 JSON 数组（v1 旧格式仍兼容：{token,uid,enterprise_id,domain}）
## 新版含 refreshToken 字段时会自动续期
export WORKBUDDY_CREDENTIALS=''

## WorkBuddy 推荐格式：手机号:AT:RT，多账号换行分隔；AT 可留空 → 手机号::RT
## 获取：node tools/workbuddy-login.cjs
## 配置后 RT 每次续期轮换并写入 STATE_DIR/wb_refresh_tokens.json，Token 永续
## 多账号可用 npm run login:workbuddy -- --export 一次性生成多行值
export WORKBUDDY_REFRESH_TOKEN=''

## Qoder 凭证 JSON 数组（推荐 PAT 模式：[{ "pat": "pt-xxxx" }]）
## 获取：node tools/extract-all-credentials.cjs --qoder-pat=pt-xxxx
export QODER_CREDENTIALS=''

## Qoder 每日额度轮次约 10:00（北京时间）刷新；本轮活动未下发时等待重试的分钟数（0=不等待，最多 30）
## 设为 5 时每 60 秒重查一次；更推荐直接把定时任务放在 10:05 之后
export QODER_WAIT=''

## 设备头（2026-09-26 起官方要求；缺失时更易只返回「本轮活动未下发」）
## UMID 三件套取自客户端 resources/umid/runtime-info.exe --account-stdin
## Cosy-ClientType：客户端常见值 10；不填默认 5
export QODER_CLIENT_TYPE=''
export QODER_MACHINE_TOKEN=''
export QODER_MACHINE_CODE=''
export QODER_MACHINE_TYPE=''
## 官方若改头字段名，用 JSON 兜底覆盖，无需改代码，例如 {"Cosy-XXX":"yyy"}
export QODER_EXTRA_HEADERS=''

## ---------------------------- ② WorkBuddy 进阶 ----------------------------

## 业务接口域名（默认 https://www.codebuddy.cn；失败自动回退 www.workbuddy.cn）
export WB_BASE_URL=''
## 刷新请求的 X-Domain（默认 www.workbuddy.cn）
export WB_X_DOMAIN=''
## 状态文件目录（默认仓库根目录；青龙建议 /ql/data，Actions 用仓库内 state/）
## 兼容别名：WB_STATE_DIR / WORKBUDDY_STATE_DIR
export STATE_DIR=''
## 账号间隔秒数（默认 3）
export WB_GAP=''
## 每轮最多补签几张（默认 1，上限 10）
export WB_MAKEUP_MAX_PER_RUN=''
## 成长任务白名单 / 黑名单，逗号分隔（黑名单优先）
export WB_TASKS=''
export WB_SKIP_TASKS=''
## 成长任务只读发现（默认 0，仅 --query 时自动开启）
export WB_GROWTH_DISCOVER=''
## 成长任务写操作 accept/claim（默认 0，置 1 才开启）
export WB_GROWTH_WRITE=''
## 签到后活跃事件上报 + 热力图回读（默认 0）
export WB_ACTIVITY_CONFIRM=''

## ③ 互动玩法（默认关闭，置 1 开启：抽奖 / 盲盒 / Buddy 信息 / 猫猫旅行）
export WB_GAMES=''
## 玩法白名单 / 黑名单（lottery,blindbox,buddy_info,travel；黑名单优先）
export WB_GAMES_TASKS=''
export WB_GAMES_SKIP=''
## 玩法接口域名（默认 https://www.workbuddy.cn，失败回退 WB_BASE_URL）
export WB_GAMES_BASE_URL=''
## 单轮上限保护：抽奖最多抽几次（默认 20）/ 盲盒最多开几个（默认 5）
export WB_GAMES_MAX_DRAWS=''
export WB_GAMES_MAX_BLINDBOX=''

## ③-b 本地凭证文件（仅本机测试用，环境变量为空时自动读取固定文件名）
## 1 = 启用（默认）/ 0 = 关闭。青龙、Actions 上无这些文件，不受影响。
## 读取：trae-credentials.json / workbuddy-credentials.json / qoder-credentials.json
##       wb_login_result.json（由 npm run login:workbuddy 生成，优先级最高）
## 保存：npm run extract 或 npm run save:creds
export LOCAL_CREDS=''

## ---------------------------- ④ 通知 ----------------------------

## 推送策略：always（默认，每次都推）/ fail（仅异常时推）/ 0（关闭 webhook）
export NOTIFY=''
## Bark（iOS），如 https://api.day.app/xxxxxxxx
export BARK_URL=''
## PushPlus 令牌
export PUSHPLUS_TOKEN=''
## WxPusher（多个 UID 用逗号/分号分隔）
export WXPUSHER_APP_TOKEN=''
export WXPUSHER_UID=''
## Server酱（sctp 开头自动走方糖专属通道）
export SERVERCHAN_SENDKEY=''
## 企业微信群机器人（完整 webhook URL 或仅 key）
export WECOM_WEBHOOK=''
## 钉钉群机器人（加签模式再填 DINGTALK_SECRET）
export DINGTALK_WEBHOOK=''
export DINGTALK_SECRET=''
## 青龙 2.18+ 面板默认通知（应用授权需 system 权限）
export QL_CLIENT_ID=''
export QL_CLIENT_SECRET=''
## 青龙面板地址（默认 http://127.0.0.1:5700）
export QL_URL=''
