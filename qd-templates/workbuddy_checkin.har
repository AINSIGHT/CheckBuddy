[
  {
    "comment": "WorkBuddy/CodeBuddy CN 签到 - 查询签到状态",
    "request": {
      "method": "POST",
      "url": "https://www.codebuddy.cn/v2/billing/meter/checkin-activity-status",
      "headers": [
        {"name": "Authorization", "value": "Bearer {{wb_token}}"},
        {"name": "Accept", "value": "application/json"},
        {"name": "Content-Type", "value": "application/json"},
        {"name": "X-User-Id", "value": "{{wb_uid}}"},
        {"name": "X-Enterprise-Id", "value": "{{wb_enterprise_id}}"},
        {"name": "X-Domain", "value": "{{wb_domain}}"}
      ],
      "cookies": [],
      "data": "{}"
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "wb_checked", "re": "\"today_checked_in\"\\s*:\\s*(true|false|1|0)", "from": "content"},
        {"name": "wb_today_credit", "re": "\"today_credit\"\\s*:\\s*(\\d+)", "from": "content"},
        {"name": "wb_streak", "re": "\"streak_days\"\\s*:\\s*(\\d+)", "from": "content"}
      ]
    }
  },
  {
    "comment": "WorkBuddy - 根据状态判断是否需要签到（已签到则跳过）",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content={{wb_checked|urlencode}}",
      "headers": [],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "wb_checked_str", "re": "\"转换后\": \"(.*)\"", "from": "content"}
      ]
    }
  },
  {
    "comment": "WorkBuddy - 执行每日签到",
    "request": {
      "method": "POST",
      "url": "https://www.codebuddy.cn/v2/billing/meter/daily-checkin",
      "headers": [
        {"name": "Authorization", "value": "Bearer {{wb_token}}"},
        {"name": "Accept", "value": "application/json"},
        {"name": "Content-Type", "value": "application/json"},
        {"name": "X-User-Id", "value": "{{wb_uid}}"},
        {"name": "X-Enterprise-Id", "value": "{{wb_enterprise_id}}"},
        {"name": "X-Domain", "value": "{{wb_domain}}"}
      ],
      "cookies": [],
      "data": "{}"
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"},
        {"re": "\"code\"\\s*:\\s*0", "from": "content"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "wb_msg", "re": "\"message\"\\s*:\\s*\"([^\"]*)\"", "from": "content"},
        {"name": "wb_credit", "re": "\"credit\"\\s*:\\s*(\\d+)", "from": "content"},
        {"name": "wb_streak_days", "re": "\"streak_days\"\\s*:\\s*(\\d+)", "from": "content"}
      ]
    }
  },
  {
    "comment": "WorkBuddy - 输出签到日志",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content=WorkBuddy%E7%AD%BE%E5%88%B0%3A%20{{wb_msg|urlencode}}%2C%20%E7%A7%AF%E5%88%86%2B{{wb_credit|urlencode}}%2C%20%E8%BF%9E%E7%BB%AD{{wb_streak_days|urlencode}}%E5%A4%A9",
      "headers": [],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"},
        {"re": "\"状态\": \"200\"", "from": "content"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "__log__", "re": "\"转换后\": \"(.*)\"", "from": "content"}
      ]
    }
  }
]
