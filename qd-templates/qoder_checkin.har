[
  {
    "comment": "Qoder 签到 - 查询签到状态。变量: qoder_token (Bearer token)。注意: Qoder token 有效期约1小时，QD 不支持自动刷新，请配合 extract-qd-variables.cjs 定期更新变量",
    "request": {
      "method": "GET",
      "url": "https://openapi.qoder.com.cn/sash/api/v1/me/daily-check-in/status",
      "headers": [
        {"name": "Authorization", "value": "Bearer {{qoder_token}}"},
        {"name": "Accept", "value": "application/json"}
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"}
      ],
      "failed_asserts": [
        {"re": "401", "from": "status"}
      ],
      "extract_variables": [
        {"name": "qoder_status", "re": "\"status\"\\s*:\\s*\"([^\"]+)\"", "from": "content"},
        {"name": "qoder_reward", "re": "\"rewardCredits\"\\s*:\\s*(\\d+)", "from": "content"},
        {"name": "qoder_streak", "re": "\"currentStreakDays\"\\s*:\\s*(\\d+)", "from": "content"},
        {"name": "qoder_total_days", "re": "\"totalClaimDays\"\\s*:\\s*(\\d+)", "from": "content"}
      ]
    }
  },
  {
    "comment": "Qoder - 执行每日签到领取 100 Credits",
    "request": {
      "method": "POST",
      "url": "https://openapi.qoder.com.cn/sash/api/v1/me/daily-check-in/claim",
      "headers": [
        {"name": "Authorization", "value": "Bearer {{qoder_token}}"},
        {"name": "Accept", "value": "application/json"},
        {"name": "Content-Type", "value": "application/json"}
      ],
      "cookies": [],
      "data": "{}"
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"},
        {"re": "\"result\"\\s*:\\s*\"(CLAIMED|ALREADY_CLAIMED)\"", "from": "content"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "qoder_result", "re": "\"result\"\\s*:\\s*\"([^\"]+)\"", "from": "content"},
        {"name": "qoder_claim_credits", "re": "\"rewardCredits\"\\s*:\\s*(\\d+)", "from": "content"},
        {"name": "qoder_claim_streak", "re": "\"currentStreakDays\"\\s*:\\s*(\\d+)", "from": "content"}
      ]
    }
  },
  {
    "comment": "Qoder - 输出签到日志",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content=Qoder%E7%AD%BE%E5%88%B0%3A%20{{qoder_result|urlencode}}%2C%20%E7%A7%AF%E5%88%86%2B{{qoder_claim_credits|urlencode}}%2C%20%E8%BF%9E%E7%BB%AD{{qoder_claim_streak|urlencode}}%E5%A4%A9%2C%20%E7%B4%AF%E8%AE%A1{{qoder_total_days|urlencode}}%E5%A4%A9",
      "headers": [],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"},
        {"re": "\"状态\": \"200\"", "from": "content"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "__log__", "re": "\"转换后\": \"(.*)\"", "from": "content"}
      ]
    }
  }
]
