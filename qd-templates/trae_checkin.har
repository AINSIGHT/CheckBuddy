[
  {
    "comment": "TRAE 签到 - 领取每日积分。注意: TRAE token 有效期较短(约数小时)，过期后需重新提取。本模板不含 token 自动刷新功能，请定期用 tools/extract-all-credentials.cjs --trae 更新变量",
    "request": {
      "method": "POST",
      "url": "{{trae_host}}/trae/api/v2/ug/checkin_credits/claim",
      "headers": [
        {"name": "Content-Type", "value": "application/json"},
        {"name": "Authorization", "value": "Cloud-IDE-JWT {{trae_token}}"},
        {"name": "x-device-id", "value": "{{trae_device_id}}-{{trae_user_id}}"}
      ],
      "cookies": [],
      "data": "{}"
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"}
      ],
      "failed_asserts": [
        {"re": "401", "from": "status"}
      ],
      "extract_variables": [
        {"name": "trae_code", "re": "\"code\"\\s*:\\s*(\\d+)", "from": "content"},
        {"name": "trae_msg", "re": "\"(?:message|msg)\"\\s*:\\s*\"([^\"]*)\"", "from": "content"},
        {"name": "trae_points", "re": "\"points\"\\s*:\\s*(\\d+)", "from": "content"}
      ]
    }
  },
  {
    "comment": "TRAE - 输出签到日志",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content=TRAE%E7%AD%BE%E5%88%B0%3A%20{{trae_msg|urlencode}}%2C%20%E7%A7%AF%E5%88%86%2B{{trae_points|urlencode}}",
      "headers": [],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {"re": "200", "from": "status"},
        {"re": "\"状态\": \"200\"", "from": "content"}
      ],
      "failed_asserts": [],
      "extract_variables": [
        {"name": "__log__", "re": "\"转换后\": \"(.*)\"", "from": "content"}
      ]
    }
  }
]
